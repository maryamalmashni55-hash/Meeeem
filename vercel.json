{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/messages/:id/like",
      "destination": "/api/like?id=:id"
    },
    {
      "source": "/api/messages",
      "destination": "/api/messages"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
